@model Honours_Dividni_AI.Models.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Ask the AI something below.</p>

    <form asp-action="Index" method="post" class="mt-4">
        <div class="mb-3">
            <textarea asp-for="Prompt" class="form-control" rows="5" placeholder="Type your prompt here..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Send</button>
    </form>

   @if (!Model.Response)
    {
        if (Model.Response)
        {
            <div class="mt-4">
                <h3>Response</h3>
                <p>Please enter a prompt</p>
            </div>
        }
        else
        {
            var qid = Model.Question.QID;
            var qstem = Model.Question.QStem;
            var correct = Model.Question.Correct;
            var incorrect = Model.Question.Incorrect;
			var qtype = Model.Question.QType;
            <div class="mt-4">
                <h3>Response</h3>
                <h4>Question ID</h4>
                <p>@qid</p>
                <h4>Stem</h4>
                <p>@qstem</p>
                <h4>Correct Answers</h4>
                <p>@correct</p>
                <h4>Incorrect Answers</h4>
                <p>@incorrect</p>
            </div>
        }
    }
</div>
